# Copy to functions/.env and adjust. Every value is optional; the defaults in
# src/config.ts apply when a key is absent. See functions/README.md for the
# rationale behind each default.

FACE_MATCH_PROVIDER=mock
FACE_APPROVE_THRESHOLD=0.85
FACE_REVIEW_THRESHOLD=0.70

DEFAULT_SITE_RADIUS_METERS=1000
MAX_GPS_ACCURACY_METERS=100
GEOFENCE_ACCURACY_GRACE=true
IMPOSSIBLE_TRAVEL_KMH=900

LIVENESS_CHALLENGE_TTL_SECONDS=90
LIVENESS_MIN_FRAMES=12

BLOCK_COMPROMISED_DEVICES=true
REJECT_UNREGISTERED_DEVICE=false

WFH_MIN_PINGS=2
WFH_MAX_PINGS=4
WFH_RESPONSE_WINDOW_MINUTES=5
WORK_DAY_START_HOUR=9
WORK_DAY_END_HOUR=18

TP_TIMEZONE=Asia/Dubai
TP_REGION=europe-west1
REQUIRE_APP_CHECK=true
