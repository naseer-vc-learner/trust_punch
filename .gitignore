# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloud Functions
functions/node_modules/
functions/lib/
functions/.env
firebase-debug.log
.firebase/

# Real Firebase config — regenerate with `flutterfire configure`.
# The checked-in google-services.json holds demo-project values only (no real
# credentials) so the Android build works out of the box against emulators;
# flutterfire configure overwrites it with the real one, which must not be committed.
ios/Runner/GoogleService-Info.plist

# Service account keys — never commit these
scripts/service-account.json
*-firebase-adminsdk-*.json

# Office documents — business material, not source
*.pptx
*.docx
*.xlsx
*.pdf

# Claude Code personal settings (a shared .claude/settings.json may be committed)
.claude/settings.local.json

# Firebase emulator exports
firebase-export-*/

# Older Flutter tooling file
.flutter-plugins

# Secrets in any folder, except the template
.env
.env.*
!.env.example

# iOS / Android signing material
*.p8
*.p12
*.cer
*.mobileprovision

# Emulator state and logs
.emulator-data/
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log

# FVM: local SDK links, never committed
.fvm/
