# Local Python environment and caches
.venv/
__pycache__/
.pytest_cache/

# Certificates and private keys are made per machine by
# scripts/make-dev-cert.sh and must never be committed (the repo is public).
certs/

# Secrets (API keys, database passwords) live here, never in git.
.env

# The server's database (attendance and device tokens): never in git.
data/
