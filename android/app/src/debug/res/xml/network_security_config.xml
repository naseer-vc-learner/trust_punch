<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY — this file lives in src/debug, so it is never merged into
  a release APK. Release builds keep Android's default: cleartext blocked.

  Android 9+ blocks cleartext HTTP. The Firebase Emulator Suite speaks plain
  HTTP over the LAN, so a physical device cannot reach it without an exemption.

  This permits cleartext generally rather than listing addresses, because
  Android's <domain> matches hostnames only — it has no CIDR support, so there
  is no way to express "any private IP". Your Mac's LAN address also changes
  between networks, which would make a fixed list wrong the moment you move.
  Safe here precisely because it cannot reach a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
