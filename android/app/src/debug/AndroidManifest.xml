<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         Debug builds follow the same transport rules as release: no cleartext
         exemption. The app's own traffic goes through dart:io, which does not
         read Android's network security config anyway; the connected app only
         talks HTTPS (plain HTTP to loopback in tests only, see server_api.dart).
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
